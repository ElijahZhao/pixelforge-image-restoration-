# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml

# Data & model weights
data/div2k/
data/lol/
models/*.pth
# Resume points (optimizer/scheduler state, tens of MB each). Local-only: they
# exist so an interrupted GPU run can continue, not to be shared.
models/ckpt/
# The trained TorchScript weights (sr_generator_scale4.pt, lowlight.pt)
# are committed so `git clone` gives a runnable project out of the box.
results/*.csv
# Exception: the full training logs ARE committed — they make the reported
# PSNR/SSIM reproducible. Historical batch8 runs + the 2026-10-07 batch16 rerun
# (three-run best-of selection, see results/README.md).
!results/train_log_sr_generator_scale4.csv
!results/train_log_lowlight_srcnn_scale2.csv
!results/train_log_sr_generator_scale4_batch16_20261007.csv
!results/train_log_sr_generator_scale2_batch16_20261007.csv
!results/train_log_lowlight_srcnn_scale2_batch16_20261007.csv

# Node / Next.js
node_modules/
web/.next/
web/out/
web/.env.local
web/vercel/

# Misc
.DS_Store
*.log
# Exception: batch16 training-run logs (2026-10-07) are committed for
# reproducibility — must come AFTER the global *.log rule to take effect.
!results/logs_batch16_20261007/*.log

# Packed source archives (avoid committing redundant zips)
pixelforge-source.zip
*.zip

# Locally packed release artifacts (git bundle + source tarball) handed to the
# GPU box; regenerated on demand, not part of the repo.
dist/

# E2E test artifacts
tests/e2e/screenshots/
tests/e2e/*.png

# Local scratch / preview renders (not part of the repo)
.preview/

# TypeScript incremental build cache
*.tsbuildinfo
.playwright-cli/

# Private archive (错题本): process evidence moved out of the public repo
archive_private/
