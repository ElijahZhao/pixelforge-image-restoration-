# Base URL of the FastAPI inference service.
#
# Local dev: leave this UNSET. The frontend then calls the same-origin
# /api path, which Next.js proxies to the FastAPI backend (see
# web/next.config.mjs) — no CORS headaches, just run both servers.
#
# Production (e.g. Hugging Face Spaces): set this to your public backend URL,
# and the frontend will call it directly (still needs CORS allow on the backend).
# NEXT_PUBLIC_API_URL=https://your-space.hf.space
